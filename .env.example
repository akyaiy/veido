APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
DB_PATH=./data/db/data.db
CAS_PATH=./data/cas
JWT_SECRET=
JWT_ISSUER=jwtproject2
JWT_AUDIENCE=jwtproject2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Canonical root URI of a separately provisioned site scope.
SITE_URI=html@site[site-acme]:///
SITE_ENTRYPOINT=index.html
SITE_TEMPLATE_KEY=default-spa
